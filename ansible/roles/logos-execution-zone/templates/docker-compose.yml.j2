---
services:
  blockchain-init:
    container_name: '{{ lez_blockchain_cont_name }}-init'
    image: '{{ lez_blockchain_cont_image }}'
    restart: 'no'
    volumes:
      - { source: '{{ lez_blockchain_config_path }}', target: '{{ lez_blockchain_config_path }}', type: bind, bind: {create_host_path: false} }
    command:
{% if not lez_blockchain_config_file.stat.exists %}
      - 'init-config'
      - '--output={{ lez_blockchain_config_file_path }}'
{% else %}
      - 'update-config'
      - '--user-config={{ lez_blockchain_config_file_path }}'
      - '--yes'
{% endif %}
      - '--log-level=debug'
      - '--state-path={{ lez_blockchain_state_path }}'
      - '--keystore={{ lez_blockchain_keystore_file_path }}'
      - '--net-port={{ lez_blockchain_cont_swarm_port }}'
      - '--http-host=0.0.0.0:{{ lez_blockchain_cont_api_port }}'
{% for peer in lez_blockchain_initial_peers %}
      - '--net-initial-peers={{ peer }}'
{% endfor %}

  blockchain:
    container_name: '{{ lez_blockchain_cont_name }}'
    image: '{{ lez_blockchain_cont_image }}'
    restart: 'always'
    depends_on:
      blockchain-init:
        condition: service_completed_successfully
    ports:
      - '{{ lez_blockchain_cont_api_port }}:{{ lez_blockchain_cont_api_port }}/tcp'
      - '{{ lez_blockchain_cont_swarm_port }}:{{ lez_blockchain_cont_swarm_port }}/tcp'
    volumes:
      - { source: '{{ lez_blockchain_state_path }}',  target: '{{ lez_blockchain_state_path }}',  type: bind, bind: {create_host_path: false} }
      - { source: '{{ lez_blockchain_config_path }}', target: '{{ lez_blockchain_config_path }}', type: bind, bind: {create_host_path: false} }
    healthcheck:
      test: ['CMD-SHELL', '{{ lez_blockchain_healthcheck_script }}']
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
    command: |
{% if lez_blockchain_deployment_config is defined %}
      --deployment='{{ lez_blockchain_deployment_path }}'
{% endif %}
      '{{ lez_blockchain_config_file_path }}'
{% if lez_blockchain_pow_mining_start %}
    post_start:
      - command: /bin/bash -c '{{ lez_blockchain_pow_mining_start_script }} &'
{% endif %}

  indexer:
    container_name: '{{ lez_indexer_cont_name }}'
    image: '{{ lez_indexer_cont_image }}'
    restart: 'always'
    depends_on:
      - blockchain
    ports:
      - '{{ lez_indexer_cont_port }}:{{ lez_indexer_cont_port }}/tcp'
    volumes:
      - { source: '{{ lez_indexer_config_path }}', target: '/etc/indexer_service/indexer_config.json', type: bind, bind: {create_host_path: false}, read_only: true }
      - { source: '{{ lez_indexer_cont_vol }}',    target: '/var/lib/indexer_service',                 type: bind, bind: {create_host_path: false}                  }
    command:
      - 'indexer_service'
      - '/etc/indexer_service/indexer_config.json'
      - '--data-dir=/var/lib/indexer_service'

{% for i in range(lez_sequencer_count) %}
  sequencer-{{ i }}:
    container_name: '{{ lez_sequencer_cont_name }}{% if lez_sequencer_count > 1 %}-{{ i }}{% endif %}'
    image: '{{ lez_sequencer_cont_image }}'
    restart: 'always'
    depends_on:
      - indexer
      - blockchain
    ports:
      - '{{ lez_sequencer_cont_base_port + i }}:{{ lez_sequencer_cont_base_port + i }}/tcp'
      - '{{ lez_sequencer_metrics_base_port + i }}:{{ lez_sequencer_metrics_base_port + i }}/tcp'
    volumes:
      - { source: '{{ lez_sequencer_config_path }}',                                  target: '/etc/sequencer_service/sequencer_config.json',   type: bind, bind: {create_host_path: false}, read_only: true }
      - { source: '{{ lez_service_conf }}/sequencer/seq-{{ i }}/signing_key',         target: '/etc/sequencer_service/signing_key',             type: bind, bind: {create_host_path: false}, read_only: true }
      - { source: '{{ lez_service_conf }}/sequencer/seq-{{ i }}/bedrock_signing_key', target: '/var/lib/sequencer_service/bedrock_signing_key', type: bind, bind: {create_host_path: false}, read_only: true }
      - { source: '{{ lez_service_data }}/sequencer/seq-{{ i }}',                     target: '/var/lib/sequencer_service',                     type: bind, bind: {create_host_path: false}                  }
    environment:
      RUST_LOG: '{{ lez_sequencer_log_level }}'
    healthcheck:
      test: ['CMD-SHELL', 'curl -sf -X POST -H "Content-Type: application/json" -d "{}" http://localhost:{{ lez_sequencer_cont_base_port + i }}/']
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
    command:
      - 'sequencer_service'
      - '/etc/sequencer_service/sequencer_config.json'
      - '--signing-key=/etc/sequencer_service/signing_key'
      - '--port={{ lez_sequencer_cont_base_port + i }}'
      - '--metrics-address=0.0.0.0:{{ lez_sequencer_metrics_base_port + i }}'

{% endfor %}
  explorer:
    container_name: '{{ lez_explorer_cont_name }}'
    image: '{{ lez_explorer_cont_image }}'
    restart: 'always'
    depends_on:
      - indexer
    ports:
      - '{{ lez_explorer_cont_port }}:{{ lez_explorer_cont_port }}/tcp'
    environment:
      INDEXER_RPC_URL: 'http://indexer:{{ lez_indexer_cont_port }}'
      LEPTOS_SITE_ADDR: '0.0.0.0:{{ lez_explorer_cont_port }}'
